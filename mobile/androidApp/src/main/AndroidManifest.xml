<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 17+: needed to reach LAN addresses (the platform server may resolve to one) -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- The app lock: the phone's fingerprint, face or PIN (platform BiometricPrompt, no Play services) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Add the app's own permissions here, each with a comment saying why it is needed. -->

    <application
        android:name=".SimpleTemplateApplication"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.SimpleTemplate.Starting">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The platform's sign-in comes back here (RFC 8252 §7.1, platform contract §2): this
                 app's own reverse-DNS scheme (build.gradle.kts, oidcScheme), so no other app is
                 offered the result. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${oidcScheme}" android:path="/oidc/callback" />
            </intent-filter>
        </activity>
    </application>
</manifest>
